    workspace "discord" {
        open-on-output "DP-1"
    }
    workspace "browser" {
        open-on-output "DP-2"
    }
    workspace "gaming" {
        open-on-output "DP-2"
    }

    window-rule {
        geometry-corner-radius 20
        clip-to-geometry true
        open-maximized true
        open-focused true
    }
    window-rule {
        match app-id="zen" at-startup=false
        open-floating true
    }
    window-rule {
        match app-id="zen" at-startup=true
        open-on-workspace "browser"
    }
    window-rule {
        match app-id="vesktop"
        open-on-workspace "discord"
        block-out-from "screen-capture"
    }
    window-rule {
        match app-id="com.mitchellh.ghostty"
        open-maximized false
        opacity 0.8
        background-effect {
            blur true
        }
    }
    window-rule {
        match app-id="steam"
        open-on-workspace "gaming"
    }
    window-rule {
       match app-id="steam"
       exclude title=r#"^[Ss]team$"#
       open-floating true
    }
    window-rule {
        match app-id="steam_proton"
        open-floating false
        open-on-workspace "gaming"
        variable-refresh-rate true
    }
    window-rule {
        match app-id="An Anime Game Launcher"
        open-on-workspace "gaming"
    }
    window-rule {
       match app-id="steam" title=r#"^notificationtoasts_\d+_desktop$"#
       default-floating-position x=10 y=10 relative-to="bottom-right"
       open-focused false
    }
    window-rule {
        match app-id="org.kde.Krita"
        open-on-output "HDMI-A-1"
    }
    window-rule {
        match app-id="org.gnome.Nautilus"
        open-maximized false
    }
    window-rule {
        match app-id="tetrio-desktop"
        open-on-workspace "gaming"
        variable-refresh-rate true
        open-fullscreen true
    }
    window-rule {
        // tetrio plus has this title when it starts,
        // unlike tetrio itself which just has the title TETR.IO
        match title="tetrio-desktop"
        variable-refresh-rate false
        open-fullscreen false
        open-floating true
    }

    layer-rule {
        match namespace="^noctalia-wallpaper*"
        place-within-backdrop true
    }
