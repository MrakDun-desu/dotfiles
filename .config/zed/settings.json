{
  "diff_view_style": "split",
  "which_key": {
    "delay_ms": 500,
    "enabled": true
  },
  "vim": {
    "use_smartcase_find": true
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": true,
  "ui_font_family": "Cantarell",
  "buffer_font_family": "FantasqueSansM Nerd Font",
  "terminal": {
    "font_family": "FantasqueSansM Nerd Font",
    "font_size": 14.0
  },
  "agent_servers": {
    "github-copilot-cli": {
      "default_config_options": {
        "mode": "https://agentclientprotocol.com/protocol/session-modes#agent"
      },
      "type": "registry"
    }
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "tree_view": true,
    "dock": "left"
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Catppuccin Mocha",
    "dark": "Catppuccin Mocha"
  },
  "ui_font_size": 15.0,
  "buffer_font_size": 14.0,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "format_on_save": "on",
  "languages": {
    "YAML": {
      "formatter": {
        "language_server": { "name": "oxfmt" }
      }
    },
    "JSON": {
      "hard_tabs": true,
      "tab_size": 4,
      "formatter": {
        "language_server": { "name": "oxfmt" }
      }
    },
    "JSONC": {
      "hard_tabs": true,
      "tab_size": 4,
      "formatter": {
        "language_server": {
          "name": "oxfmt"
        }
      }
    },
    "TypeScript": {
      "hard_tabs": true,
      "tab_size": 3,
      "formatter": {
        "language_server": { "name": "oxfmt" }
      }
    },
    "Svelte": {
      "hard_tabs": true,
      "tab_size": 3,
      "formatter": {
        "language_server": { "name": "oxfmt" }
      }
    },
    "Markdown": {
      "hard_tabs": false,
      "tab_size": 3,
      "formatter": {
        "language_server": { "name": "oxfmt" }
      }
    }
  },
  "lsp": {
    "vtsls": {
      "settings": {
        "typescript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        },
        "javascript": {
          "updateImportsOnFileMove": {
            "enabled": "always"
          }
        }
      },
      "enable_lsp_tasks": true
    },
    "eslint": {
      "settings": {
        "onIgnoredFiles": "off"
      }
    }
  },
  "semantic_tokens": "combined",
  "show_whitespaces": "all",
  "vertical_scroll_margin": 10
}
