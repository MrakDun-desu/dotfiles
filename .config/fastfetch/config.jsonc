{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 2
        },
        "source": "$HOME/Pictures/Pfps/mari_no_bg.png",
        "type": "auto",
        "height": 25,
        "width": 62
    },
    "modules": [
        "title",
        "separator",
        "os",
        "uptime",
        "packages",
        "shell",
        "editor",
        "display",
        "de",
        "wm",
        "wmtheme",
        "theme",
        "cursor",
        "terminal",
        "terminalfont",
        {
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true
        },
        "memory",
        "disk",
        "datetime",
        "break",
        "colors"
    ]
}
