[init]
    defaultBranch = main

[user]
    name = MrakDundesu
    email = m.danco@protonmail.com

[core]
    editor = nvim
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

